# Reference for the environment variables to set in the Railway dashboard for the
# API service. Not loaded automatically — copy/paste into Railway's Variables tab.
# Do not commit real secrets to this file.

APP_NAME=Aura
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://<your-api>.up.railway.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/google/callback

LOG_CHANNEL=stack
LOG_LEVEL=info

# NOTE: config/database.php reads DB_HOST only when LARAVEL_SAIL is set (Sail dev
# containers). Outside Sail it reads DB_HOST_HOST instead — set that one here.
DB_CONNECTION=pgsql
DB_HOST_HOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_DATABASE=${{Postgres.POSTGRES_DB}}
DB_USERNAME=${{Postgres.POSTGRES_USER}}
DB_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}
DB_SSLMODE=disable              # internal Railway network traffic; not needed over the private network

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# Internal Railway networking to the music-omr-engine service (port 8000 in its Dockerfile).
OMR_API_URL=http://${{music-omr-engine.RAILWAY_PRIVATE_DOMAIN}}:8000

# Pitch-analysis runs as a sidecar process inside this same container (see
# docker/production/supervisord.conf) — always localhost, never change.
PITCH_ANALYSIS_API_URL=http://127.0.0.1:8001

MAIL_MAILER=log
